<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Bitácora</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <h1>Registro de Bitácora</h1>
    <form action="/bitacora" method="POST">
        <label for="fecha_hora_ronda">Fecha y Hora de la Ronda: </label>
        <input type="datetime-local" id="fecha_hora_ronda" name="fecha_hora_ronda" required>
        
        <label for="area_sector_revisado">Área/Sector Revisado: </label>
        <input type="text" id="area_sector_revisado" name="area_sector_revisado" required>
        
        <label for="punto_control">Punto de Control (Checklist): </label>
        <input type="text" id="punto_control" name="punto_control" required>
        
        <label for="estado">Estado (OK/Fallo): </label>
        <select id="estado" name="estado" required>
            <option value="">Seleccione...</option>
            <option value="OK">OK</option>
            <option value="Fallo">Fallo</option>
        </select>
        
        <label for="observaciones">Observaciones: </label>
        <textarea id="observaciones" name="observaciones" rows="3"></textarea>
        
        <label for="seguimiento_requerido">Seguimiento Requerido: </label>
        <select id="seguimiento_requerido" name="seguimiento_requerido">
            <option value="No">No</option>
            <option value="Sí">Sí</option>
        </select>
        
        <label for="inspector_operador">Inspector/Operador: </label>
        <input type="text" id="inspector_operador" name="inspector_operador" required>
        
        <button type="submit">Registrar Inspección</button>
    </form>
    <ul>
        <% bitacoras.forEach(function(bitacora){ %>
            <li><strong><%= bitacora.fecha_hora_ronda %></strong> - <%= bitacora.area_sector_revisado %> 
            (Punto: <%= bitacora.punto_control %>, Estado: <%= bitacora.estado %>, Inspector: <%= bitacora.inspector_operador %>)
            <a href="/bitacora/edit/<%= bitacora.id %>">Editar</a>
            <a href="/bitacora/delete/<%= bitacora.id %>">Eliminar</a>
            </li>
        <% }); %>
    </ul>

    <footer>  <a href="../index.html">Regresamos al menu principal</a></footer>
</body>
</html>